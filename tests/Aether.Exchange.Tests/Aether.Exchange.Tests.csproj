<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同仓三项目 + 测试即齐——刻意不引 ctp-net-contracts/ctp-net-front：
         Exchange 是层 1 引擎仓（DAG 单向），协议映射归 Front（层 2）；
         协议侧接缝契约测试在 ctp-net-front/tests（RemoteCtpSession/SessionAdapter 一族）。
         CI 因此无须 checkout 兄弟仓。 -->
    <ProjectReference Include="..\..\src\Aether.Exchange\Aether.Exchange.csproj" />
    <ProjectReference Include="..\..\src\Aether.Exchange.Storage\Aether.Exchange.Storage.csproj" />
    <ProjectReference Include="..\..\src\Aether.Exchange.Rpc\Aether.Exchange.Rpc.csproj" />
  </ItemGroup>

</Project>
